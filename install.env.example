# Optional configuration for the guided AWS terminal installer.
#
# Usage:
#   cp install.env.example install.env
#   edit install.env
#   set -a
#   source install.env
#   set +a
#   npm run install:aws
#
# For a fully non-interactive run, set NON_INTERACTIVE=true and CONFIRM_INSTALL=true.

AWS_REGION="ap-southeast-2"
TESTIMONIAL_BUCKET="jta-data-bucket"
TESTIMONIAL_PREFIX="JTA data set/"
BEDROCK_MODEL_ID="anthropic.claude-3-5-sonnet-20240620-v1:0"

# Replace this with the actual CIDR range assigned to your VPN/private clients.
# Comma-separated values are supported.
PRIVATE_CLIENT_CIDRS="10.50.0.0/22"

# Installer behaviour controls.
CHECK_S3_PREFIX=true
RUN_CDK_BOOTSTRAP=true
AUTO_APPROVE_CDK=true
RETRIEVE_ADMIN_SECRET=true
CONFIRM_INSTALL=true

# Set to true only after install.env has been reviewed.
NON_INTERACTIVE=false
